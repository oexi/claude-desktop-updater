# Generated by claude-desktop-updater (scripts/build-pacman.sh) — do not edit the
# rendered copy; edit packaging/arch/PKGBUILD.in instead.
#
# Based on the AUR claude-desktop PKGBUILD by Kevin <developer@kev314.dev>.
#
# Repackages Anthropic's official Debian package for Arch. Only the .deb's
# file payload (data.tar.*) is used. Its maintainer scripts do
# Debian/Ubuntu-specific work (apt repository, AppArmor), plus a few
# distribution-neutral steps that are reproduced below as static files
# (GNOME search provider, MIME types, the optional `ccd` launcher link).

pkgname=claude-desktop
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc="Official Claude AI desktop app from Anthropic — Chat, Cowork, and Claude Code"
arch=('x86_64' 'aarch64')
url="https://claude.com/download"
license=('LicenseRef-Proprietary')

# Debian "Depends:" translated to Arch names, plus libraries the shipped
# binaries link directly. alsa-lib is only "Recommends:" upstream, but
# Chromium needs it for audio output.
depends=('alsa-lib'
         'at-spi2-core'
         'bubblewrap'
         'cairo'
         'dbus'
         'expat'
         'gcc-libs'
         'glib2'
         'glibc'
         'gtk3'
         'hicolor-icon-theme'
         'libcap-ng'
         'libcups'
         'libdrm'
         'libnotify'
         'libpipewire'
         'libseccomp'
         'libsecret'
         'libx11'
         'libxcb'
         'libxcomposite'
         'libxdamage'
         'libxext'
         'libxfixes'
         'libxkbcommon'
         'libxrandr'
         'libxtst'
         'mesa'
         'nspr'
         'nss'
         'pango'
         'socat'
         'systemd-libs'
         'util-linux-libs'
         'virtiofsd'
         'xdg-desktop-portal'
         'xdg-utils')

# Cowork runs its sandbox inside a QEMU VM (upstream "Recommends:").
depends_x86_64=('qemu-system-x86' 'edk2-ovmf')
# Arch Linux ARM has no edk2 firmware package, so keep the VM stack optional.
optdepends_aarch64=('qemu-system-aarch64: run Cowork tasks in a local virtual machine'
                    'edk2-aarch64: UEFI firmware for the Cowork virtual machine')

optdepends=('gnome-keyring: credential storage via Secret Service (GNOME)'
            'kwallet: credential storage (KDE Plasma)'
            'libayatana-appindicator: system tray icon'
            'openssh: system SSH client for remote sessions'
            'xdg-desktop-portal-gtk: portal backend for GTK desktops'
            'xdg-desktop-portal-kde: portal backend for KDE Plasma')

conflicts=('claude' 'claude-desktop-bin')

# Prebuilt Electron/Chromium binaries: stripping can corrupt them (and must
# not run x86 binutils over aarch64 binaries when cross-packaging).
options=('!strip' '!debug')

_baseurl="https://downloads.claude.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop"
source=("${pkgname}.sh")
source_x86_64=("${_baseurl}/${pkgname}_${pkgver}_amd64.deb")
source_aarch64=("${_baseurl}/${pkgname}_${pkgver}_arm64.deb")
sha256sums=('@SHA_LAUNCHER@')
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
  # The .deb (an ar archive) is unpacked by makepkg; data.tar.* is the payload.
  tar -xf data.tar.* -C "$pkgdir"

  local appdir="$pkgdir/usr/lib/claude-desktop"

  # Replace upstream's bare symlink with a launcher that selects the
  # Wayland backend when appropriate (see claude-desktop.sh).
  rm -f "$pkgdir/usr/bin/claude-desktop"
  install -Dm755 "$pkgname.sh" "$pkgdir/usr/bin/claude-desktop"

  # Chromium's setuid sandbox helper (fallback for kernels without
  # unprivileged user namespaces, e.g. linux-hardened).
  chmod 4755 "$appdir/chrome-sandbox"

  # Debian lintian overrides have no consumer on Arch.
  rm -rf "$pkgdir/usr/share/lintian"

  # --- Static equivalents of the .deb postinst ---------------------------
  # GNOME Shell search provider (D-Bus activated GJS script under resources/).
  local sp="$appdir/resources/gnome-search-provider"
  if [[ -d $sp ]]; then
    install -Dm644 "$sp/com.anthropic.Claude.search-provider.ini" \
      "$pkgdir/usr/share/gnome-shell/search-providers/com.anthropic.Claude.search-provider.ini"
    install -Dm644 "$sp/com.anthropic.Claude.SearchProvider.service" \
      "$pkgdir/usr/share/dbus-1/services/com.anthropic.Claude.SearchProvider.service"
  fi
  # MIME types for .mcpb / .dxt / .skill (pacman's shared-mime-info hook
  # runs update-mime-database).
  local mime="$appdir/resources/linux-mime/com.anthropic.Claude.xml"
  if [[ -f $mime ]]; then
    install -Dm644 "$mime" "$pkgdir/usr/share/mime/packages/com.anthropic.Claude.xml"
  fi
  # `ccd` terminal launcher, only when this build ships one.
  if [[ -x $appdir/resources/bin/ccd ]]; then
    ln -s ../lib/claude-desktop/resources/bin/ccd "$pkgdir/usr/bin/ccd"
  fi

  # --- Cowork compatibility shims: the app hardcodes Debian paths --------
  # virtiofsd: the app looks in /usr/bin and /usr/libexec; Arch has /usr/lib.
  ln -s ../lib/virtiofsd "$pkgdir/usr/bin/virtiofsd"

  # UEFI firmware: the app opens /usr/share/OVMF/OVMF_CODE_4M.fd (Debian
  # naming); on Arch /usr/share/OVMF -> /usr/share/edk2 (edk2-ovmf).
  # aarch64 needs no shim: edk2-aarch64 installs /usr/share/AAVMF/AAVMF_CODE.fd.
  if [[ $CARCH == x86_64 ]]; then
    install -d "$pkgdir/usr/share/edk2"
    ln -s x64/OVMF_CODE.4m.fd "$pkgdir/usr/share/edk2/OVMF_CODE_4M.fd"
    ln -s x64/OVMF_VARS.4m.fd "$pkgdir/usr/share/edk2/OVMF_VARS_4M.fd"
  fi

  install -Dm644 "$pkgdir/usr/share/doc/claude-desktop/copyright" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
