# Generated by claude-desktop-updater (scripts/build-rpm.sh) — edit
# packaging/rpm/claude-desktop.spec.in instead of the rendered copy.
#
# Repackages the file payload of Anthropic's official Debian package as an
# RPM. Prebuilt Electron/Chromium binaries: no compilation, no stripping,
# no debuginfo. Built with `rpmbuild --target <arch>`, so the same spec
# packages aarch64 on an x86_64 host.

%global debug_package %{nil}
%global _build_id_links none
# Skips brp-strip & co., which would run host binutils over foreign binaries.
%global __os_install_post %{nil}
# Bundled libraries are private to the app: export none of them, and do not
# require the one other ELF files link against (libffmpeg.so).
%global __provides_exclude_from ^/usr/lib/claude-desktop/.*$
%global __requires_exclude ^libffmpeg\\.so.*$
# zstd level 10, all threads: far faster than the distro default (19) on a
# ~600 MiB payload, and readable by every rpm >= 4.14.
%global _binary_payload w10T0.zstdio

Name:           claude-desktop
Version:        @VERSION@
Release:        @RELEASE@
Summary:        Claude desktop app (Chat, Cowork and Claude Code), repackaged from the official .deb
License:        LicenseRef-Proprietary
URL:            https://claude.ai/download
Source0:        @DATA_TARBALL@
Source1:        claude-desktop.sh

ExclusiveArch:  x86_64 aarch64
AutoProv:       no

# Libraries are found by rpm's ELF dependency generator (sonames, so the
# result is valid on Fedora, RHEL and openSUSE alike). Only non-library
# runtime needs are listed here; distribution-specific names stay
# Recommends so a missing name never blocks installation.
Requires:       xdg-utils
Requires:       xdg-desktop-portal
Recommends:     (xdg-desktop-portal-gtk or xdg-desktop-portal-gnome or xdg-desktop-portal-kde)
Recommends:     libayatana-appindicator-gtk3
Recommends:     (gnome-keyring or kf6-kwallet)
Recommends:     bubblewrap
Recommends:     socat
Recommends:     openssh-clients
Recommends:     virtiofsd
%ifarch x86_64
Recommends:     qemu-system-x86-core
Recommends:     edk2-ovmf
%endif
%ifarch aarch64
Recommends:     qemu-system-aarch64-core
Recommends:     edk2-aarch64
%endif

%description
Desktop application for Claude.ai: Chat, Cowork and Claude Code.

Unofficial RPM build: the files are taken unchanged from Anthropic's
official Debian package; only /usr/bin/claude-desktop is replaced by a
launcher that selects the Wayland backend in Wayland sessions.

%prep
# Nothing to unpack: %%install extracts the payload tarball directly.

%build
# Prebuilt binaries.

%install
mkdir -p %{buildroot}
tar -xf %{SOURCE0} -C %{buildroot}
appdir=%{buildroot}/usr/lib/claude-desktop

rm -rf %{buildroot}/usr/share/lintian
rm -f %{buildroot}/usr/bin/claude-desktop
install -Dm755 %{SOURCE1} %{buildroot}/usr/bin/claude-desktop
chmod 4755 "$appdir/chrome-sandbox"

# Static equivalents of the .deb postinst. Fedora's file triggers refresh
# the MIME, desktop and icon caches, so no scriptlets are needed.
sp="$appdir/resources/gnome-search-provider"
if [ -d "$sp" ]; then
  install -Dm644 "$sp/com.anthropic.Claude.search-provider.ini" \
    %{buildroot}/usr/share/gnome-shell/search-providers/com.anthropic.Claude.search-provider.ini
  install -Dm644 "$sp/com.anthropic.Claude.SearchProvider.service" \
    %{buildroot}/usr/share/dbus-1/services/com.anthropic.Claude.SearchProvider.service
fi
mime="$appdir/resources/linux-mime/com.anthropic.Claude.xml"
if [ -f "$mime" ]; then
  install -Dm644 "$mime" %{buildroot}/usr/share/mime/packages/com.anthropic.Claude.xml
fi
if [ -x "$appdir/resources/bin/ccd" ]; then
  ln -s ../lib/claude-desktop/resources/bin/ccd %{buildroot}/usr/bin/ccd
fi
# The app finds virtiofsd in /usr/libexec and firmware at
# /usr/share/OVMF/OVMF_CODE.fd or /usr/share/AAVMF/AAVMF_CODE.fd — where
# Fedora installs them — so no path shims are needed here.

# File list generated from the payload, so new upstream files never break
# the build. Directories are owned only under our own trees.
filelist="$PWD/%{name}.files"
(
  cd %{buildroot}
  find usr/lib/claude-desktop usr/share/doc/claude-desktop -type d | sed 's|^|%%dir "/|; s|$|"|'
  find usr \( -type f -o -type l \) ! -path usr/lib/claude-desktop/chrome-sandbox | sed 's|^|"/|; s|$|"|'
  echo '%%attr(4755,root,root) "/usr/lib/claude-desktop/chrome-sandbox"'
) > "$filelist"

%files -f %{name}.files
%defattr(-,root,root,-)

%changelog
* @CHANGELOG_DATE@ claude-desktop-updater - @VERSION@-@RELEASE@
- Repackaged from the official claude-desktop @VERSION@ Debian package.
